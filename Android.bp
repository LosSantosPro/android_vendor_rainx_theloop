cc_prebuilt_library_shared {
	name: "libfmjni",
	owner: "rainx",
	strip: {
		none: true,
	},
	target: {
		android_arm64: {
			srcs: ["proprietary/system_ext/lib64/libfmjni.so"],
		},
	},
	compile_multilib: "64",
	// AOSP source libfmjni breaks RDS (no radio text). MTK prebuilt
	// has working RDS. No signal quality difference between the two.
	prefer: true,
	check_elf_files: false,
	// Cannot be system_ext_specific - Soong rejects prefer:true when
	// prebuilt partition differs from source module (libfmjni is /system).
	// FMRadio linker namespace covers both paths.
}

