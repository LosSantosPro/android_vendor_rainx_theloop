// libaudio_aidl_conversion_common_ndk - not a prebuilt here; AOSP defines a
// system-only module and Soong rejects cross-partition prebuilt substitution.
// Installed via PRODUCT_COPY_FILES in theloop-vendor.mk instead.
// Must use the V3 blob (matches stock) to avoid struct layout mismatch
// in the vendor linker namespace (V4 DT_NEEDEDs cause stack-protector
// aborts in setAudioPortConfigVectorToLegacy).

